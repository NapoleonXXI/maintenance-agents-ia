{
  "name": "maintenance-agents-ia – Pilote",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.3",
  "features": { "ghcr.io/devcontainers/features/python:1": { "version": "3.12" } },
  "postCreateCommand": "bash .devcontainer/demarrer-pilote.sh init",
  "postStartCommand": "bash .devcontainer/demarrer-pilote.sh",
  "forwardPorts": [8810],
  "portsAttributes": { "8810": { "label": "Pilote", "onAutoForward": "openBrowser" } }
}
