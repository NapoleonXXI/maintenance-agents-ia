<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Pilote – <%= content_for(:titre) || "Accueil" %></title>
  <%= csrf_meta_tags %>
  <link rel="stylesheet" href="/pilote.css">
</head>
<body>
<% if content_for?(:nu) %><%= yield %><% else %>
  <header><a href="/">🧭 Pilote</a> <small>· <%= content_for(:titre) || "Accueil" %></small></header>
  <main>
    <% if notice %><p class="flash"><%= notice %></p><% end %>
    <% if alert %><p class="note"><%= alert %></p><% end %>
    <%= yield %>
    <p style="text-align:center;font-size:14px">
      <%= nom_humain ? "Vous êtes : #{nom_humain}" : "Prénom non défini" %> · <a href="/nom">changer</a></p>
  </main>
<% end %>
<nav class="barre">
  <a href="/" aria-label="Accueil">🏠</a>
  <a href="<%= journal_interventions_path %>">📋<span>Journal d'interventions</span></a>
  <a href="<%= a_venir_path %>">⋯<span>À venir</span></a>
</nav>
</body>
</html>
